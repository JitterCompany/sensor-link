/*
Linker script include file for bootloader/bootloadable
*/

INCLUDE inc_base.x

MEMORY
{
  /* Note: all flash sections must be defined in multiles of 8K
     Bootloader flash: 64K(?) last 128 bytes: bootloader meta (version number)
  */
  FLASH_BOOTLOADER : ORIGIN = ORIGIN(FLASH_AVAILABLE), LENGTH = 128K - 128
  FLASH_BOOTLOADER_META : ORIGIN = ORIGIN(FLASH_BOOTLOADER) + LENGTH(FLASH_BOOTLOADER), LENGTH = 128

  /* Application flash: 2MB - bootloader - config
     First 512 bytes: metadata (length, signature, etc)
     Note: this must be 512 (or a multiple of 512), see cortex-M4 VTOR register
  */
  FLASH_APP_META : ORIGIN = ORIGIN(FLASH_BOOTLOADER_META) + LENGTH(FLASH_BOOTLOADER_META), LENGTH = 512
  FLASH_APP_CODE : ORIGIN = ORIGIN(FLASH_APP_META) + LENGTH(FLASH_APP_META), LENGTH = LENGTH(FLASH_AVAILABLE) - (ORIGIN(FLASH_APP_META) - ORIGIN(FLASH_BOOTLOADER)) - LENGTH(FLASH_APP_META)


  /* OTP area: each block of 8 bytes can be written exactly once*/
  FLASH_OTP : ORIGIN = 0x1FFF7000, LENGTH = 1K

  RAM : ORIGIN = ORIGIN(RAM_AVAILABLE), LENGTH = LENGTH(RAM_AVAILABLE)
}



__FLASH_BOOTLOADER_START = ORIGIN(FLASH_BOOTLOADER);
__FLASH_BOOTLOADER_LENGTH = LENGTH(FLASH_BOOTLOADER);

__FLASH_BOOTLOADER_META_START = ORIGIN(FLASH_BOOTLOADER_META);
__FLASH_BOOTLOADER_META_LENGTH = LENGTH(FLASH_BOOTLOADER_META);

__FLASH_APP_META_START = ORIGIN(FLASH_APP_META);
__FLASH_APP_META_LENGTH = LENGTH(FLASH_APP_META);

__FLASH_APP_CODE_START = ORIGIN(FLASH_APP_CODE);
__FLASH_APP_CODE_LENGTH = LENGTH(FLASH_APP_CODE);

__FLASH_APP_TOTAL_START = __FLASH_APP_META_START;
__FLASH_APP_TOTAL_LENGTH = __FLASH_APP_META_LENGTH + __FLASH_APP_CODE_LENGTH;
