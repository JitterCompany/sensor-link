# Copy to demo-server/demo-server.env (git-ignored) and fill in.
MQTT_BROKER_HOST_NAME=mosquitto
MQTT_BROKER_PORT=8883
MQTT_CA_CERT_PATH=/demo-server/config/ca.pem
MQTT_CLIENT_CERT_PATH=/demo-server/config/demo-server.cert
MQTT_CLIENT_KEY_PATH=/demo-server/config/demo-server.key
# Same values as POSTGRES_* in .env
TIMESCALEDB_URL=postgres://demo:CHANGE_ME@timescaledb:5432/demo?sslmode=disable
HTTP_BIND_ADDR=0.0.0.0:8087
FIRMWARE_DIR=/firmwares
FIRMWARE_BASE_URL=https://mqtt.demo.example/fw
RUST_LOG=info
