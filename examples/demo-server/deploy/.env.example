# Copy to .env (git-ignored) next to docker-compose.yml and fill in.
# Public host name of this server: MQTT broker, API and firmware downloads
DEMO_HOST=mqtt.demo.example
# Let's Encrypt account email (expiry warnings)
ACME_EMAIL=admin@demo.example
POSTGRES_DB=demo
POSTGRES_USER=demo
# A random password without URL-special characters: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
