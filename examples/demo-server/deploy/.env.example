# Copy to .env (git-ignored) next to docker-compose.yml and fill in.
# Public host name of this server: MQTT broker, API and firmware downloads
DEMO_HOST=mqtt.demo.example
# TLS for the HTTP side (API, firmware downloads), pick one:
# - Traefik with Let's Encrypt, when ports 80 and 443 are free:
#COMPOSE_PROFILES=traefik
#ACME_EMAIL=admin@demo.example
# - a reverse proxy on the host forwarding to these localhost ports:
DEMO_HTTP_PORT=8087
DEMO_FIRMWARE_PORT=8088
POSTGRES_DB=demo
POSTGRES_USER=demo
# A random password without URL-special characters: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
